# ---------------------------------------------------------------------------
# MovieFlix API — copy to `.env` and adjust for your machine.
# Every variable here is declared in src/config/env.validation.ts; the process
# refuses to boot if one is missing or malformed.
# ---------------------------------------------------------------------------

# ---- runtime ----
NODE_ENV=development
PORT=3001
API_PREFIX=api
API_VERSION=1
# Comma-separated list of browser origins allowed to call this API.
# Scheme + host, no trailing slash and no path: https://moviefix.vercel.app
#
# Only needed for origins that reach this API *from a browser*. If the web app
# proxies /api through its own origin (API_PROXY_ORIGIN on the frontend), the
# calls arrive server-to-server and CORS never enters into it — leave the
# localhost value and the deployed app still works.
#
# Vercel preview deployments each get their own hostname, so a fixed list will
# not cover them. Proxying avoids that problem entirely.
CORS_ORIGINS=http://localhost:3000

# How long the readiness probe waits for the database, in milliseconds. The
# first ping of a deploy pays for the connection, the TLS handshake and the pool
# warming up; against a managed Postgres that is seconds, not milliseconds. Too
# low here and the platform kills the container before it ever serves a request.
HEALTH_DB_TIMEOUT_MS=5000

# ---- database (PostgreSQL) ----
# On a managed Postgres (Railway, Render, Neon) set DATABASE_URL alone and leave
# the five variables below unset — they take precedence when present.
# DATABASE_URL=postgresql://user:password@host:5432/database
#
# On Supabase, use the pooler in SESSION mode — the pooler host, port 5432.
# Port 6543 on that same host is transaction mode: the connection returns to the
# pool after every statement, which suits the application but breaks migrations,
# since a migration runner needs session state and locks held across statements.
# Session mode serves both, so one URL is enough.
#
# Run the seeders on the next deploy. Leave unset afterwards: they are
# idempotent, but re-running them every deploy should be a decision.
# RUN_SEED=false

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=movieflix
DB_PASSWORD=movieflix
DB_NAME=movieflix
DB_SSL=false
DB_LOGGING=true
# Leave false. Schema changes go through migrations, never sequelize sync.
DB_SYNCHRONIZE=false
DB_POOL_MAX=10

# ---- observability ----
LOG_LEVEL=debug
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# ---- auth / JWT ----
# Two different secrets: a leaked access secret must not be able to mint
# refresh tokens. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-a-48-byte-random-string-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-me-with-a-different-48-byte-random-string
JWT_REFRESH_TTL=30d
JWT_ISSUER=movieflix-api
JWT_AUDIENCE=movieflix-web

# Cost factor for bcrypt. Raise it as hardware improves; never go below 10.
BCRYPT_ROUNDS=12

# Per-account brute-force lockout (independent of the IP rate limit below).
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# ---- cookies ----
# MUST be true anywhere that is not localhost. `SameSite=None` is rejected by
# browsers without it.
COOKIE_SECURE=false

# `lax` when the browser sees the API on the same site as the web app — which
# includes the proxied setup, since the cookies then belong to the app's own
# origin. Keep `lax`: it is the CSRF defence.
#
# `none` is only for genuinely cross-site calls (app on vercel.app, API called
# directly on up.railway.app). Understand the cost before choosing it: Safari
# blocks these cookies outright, and Chrome is restricting them, so a share of
# users simply never stay signed in. The frontend's `middleware.ts` cannot see
# them either, because they belong to another domain — every protected route
# would redirect to /login. Proxy instead.
COOKIE_SAME_SITE=lax

# Leave empty for a host-only cookie, which is what you want on *.vercel.app or
# *.up.railway.app: both are on the Public Suffix List, so a browser refuses a
# Domain attribute for them. Only set this for a real shared parent domain you
# own, e.g. .midominio.com with the app on www. and the API on api.
COOKIE_DOMAIN=

# ---- rate limiting ----
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=10
AUTH_REGISTER_THROTTLE_LIMIT=5
AUTH_REFRESH_THROTTLE_LIMIT=30
AUTH_REGISTER_THROTTLE_LIMIT=5
AUTH_REFRESH_THROTTLE_LIMIT=30

# ---- seed credentials ----
# Consumed by database/seeders/20260101000600-admin-user.js.
# Change the password immediately after the first login.
SEED_ADMIN_EMAIL=admin@movieflix.test
SEED_ADMIN_PASSWORD=Admin123!Change
SEED_PROVIDER_PASSWORD=Provider123!Change
SEED_USER_PASSWORD=User123!Change

# ---- object storage (Supabase) ----
# Optional: without SUPABASE_URL + SUPABASE_SECRET_KEY the API boots normally
# and only image uploads fail, with a 503.
# SUPABASE_URL is an alias of the older STORAGE_URL; either works.
SUPABASE_URL=https://your-project.supabase.co
# Service-role key. It bypasses row-level security — server-side only, and
# never behind a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=replace-me-with-the-service-role-key
SUPABASE_STORAGE_BUCKET=movieflix
UPLOAD_MAX_FILE_SIZE_MB=10

# ---- image optimisation ----
# Uploads are re-encoded before storage: resized into a bounding box, stripped
# of metadata and recompressed. `webp` is ~25-35% smaller than JPEG at matching
# visual quality; use `original` to keep the source format, `avif` for the
# smallest files.
IMAGE_TARGET_FORMAT=webp
# 82 is the usual visually-lossless point. Above ~90 costs bytes for no
# perceptible gain.
IMAGE_QUALITY=82
IMAGE_MAX_WIDTH=1280
IMAGE_MAX_HEIGHT=1920
